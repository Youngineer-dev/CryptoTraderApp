<UserControl x:Class="CryptoTraderApp.Views.TradingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:CryptoTraderApp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:TradingViewModel}"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="#121418">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header Ticker Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Trading Workstation Grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER: Ticker Bar & Market Info -->
        <Border Grid.Row="0" Style="{StaticResource TradingCardStyle}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Symbol Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Money24" FontSize="22" Foreground="#F0B90B" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding MarketList}" 
                              SelectedItem="{Binding SelectedMarket}" 
                              DisplayMemberPath="Symbol"
                              Width="150" Height="36" 
                              FontSize="15" FontWeight="Bold" 
                              Background="#1E2329" Foreground="#EAECEF"
                              BorderBrush="#2B313A"/>
                </StackPanel>

                <!-- Current Price & 24h Change -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="{Binding SelectedMarket.FormattedPrice, FallbackValue='67,450.00'}" 
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{Binding SelectedMarket.IsPositive, Converter={x:Null}, FallbackValue='#0ECB81'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0ECB81"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMarket.IsPositive}" Value="False">
                                            <Setter Property="Foreground" Value="#F6465D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="실시간 체결가 (USDT)" FontSize="10" Foreground="#848E9C"/>
                    </StackPanel>

                    <Border CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#16382E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMarket.IsPositive}" Value="False">
                                        <Setter Property="Background" Value="#3B2228"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SelectedMarket.FormattedChange, FallbackValue='+3.42%'}" 
                                   FontWeight="SemiBold" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0ECB81"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMarket.IsPositive}" Value="False">
                                            <Setter Property="Foreground" Value="#F6465D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- High, Low, Volume Stats -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="24h 최고가" FontSize="11" Foreground="#848E9C"/>
                        <TextBlock Text="{Binding SelectedMarket.High24h, StringFormat='{}{0:N2}', FallbackValue='68,200.00'}" 
                                   FontSize="13" FontWeight="SemiBold" Foreground="#EAECEF"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="24h 최저가" FontSize="11" Foreground="#848E9C"/>
                        <TextBlock Text="{Binding SelectedMarket.Low24h, StringFormat='{}{0:N2}', FallbackValue='65,120.00'}" 
                                   FontSize="13" FontWeight="SemiBold" Foreground="#EAECEF"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="24h 거래량" FontSize="11" Foreground="#848E9C"/>
                        <TextBlock Text="{Binding SelectedMarket.Volume24h, StringFormat='{}{0:N0} USDT', FallbackValue='142,850,500'}" 
                                   FontSize="13" FontWeight="SemiBold" Foreground="#EAECEF"/>
                    </StackPanel>
                </StackPanel>

                <!-- Time Interval Switcher -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="주기:" VerticalAlignment="Center" Foreground="#848E9C" Margin="0,0,8,0" FontSize="12"/>
                    <RadioButton Content="1m" Style="{DynamicResource ToggleButtonRadioGroupDefault}" Height="28" Width="40" Background="#1E2329"/>
                    <RadioButton Content="5m" Style="{DynamicResource ToggleButtonRadioGroupDefault}" Height="28" Width="40" Background="#1E2329"/>
                    <RadioButton Content="15m" IsChecked="True" Style="{DynamicResource ToggleButtonRadioGroupDefault}" Height="28" Width="40" Background="#1E2329"/>
                    <RadioButton Content="1h" Style="{DynamicResource ToggleButtonRadioGroupDefault}" Height="28" Width="40" Background="#1E2329"/>
                    <RadioButton Content="4h" Style="{DynamicResource ToggleButtonRadioGroupDefault}" Height="28" Width="40" Background="#1E2329"/>
                    <RadioButton Content="1D" Style="{DynamicResource ToggleButtonRadioGroupDefault}" Height="28" Width="40" Background="#1E2329"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN WORKSTATION GRID: Left (Chart + Bottom Tabs) | Right (OrderBook + Manual Order) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT AREA ================= -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <!-- Candlestick Chart -->
                    <RowDefinition Height="3*"/>
                    <!-- Bottom Positions / Orders / Bot Status -->
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!-- Chart Container -->
                <Border Grid.Row="0" Style="{StaticResource TradingCardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Chart Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedMarket.Symbol, FallbackValue='BTC/USDT'}" 
                                           FontWeight="Bold" FontSize="14" Foreground="#EAECEF" Margin="0,0,8,0"/>
                                <TextBlock Text="실시간 캔들스틱 차트 (LiveCharts2)" FontSize="12" Foreground="#848E9C" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Background="#16382E" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="● MA(7, 25, 99)" Foreground="#0ECB81" FontSize="11"/>
                                </Border>
                                <Border Background="#1E2329" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="VOL: Realtime" Foreground="#848E9C" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- LiveCharts2 Candlestick Chart -->
                        <lvc:CartesianChart Grid.Row="1"
                                            Series="{Binding CandleSeries}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            ZoomMode="X" />
                    </Grid>
                </Border>

                <!-- Bottom Monitoring Panel (Tabs) -->
                <Border Grid.Row="1" Style="{StaticResource TradingCardStyle}">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <!-- TAB 1: Positions -->
                        <TabItem Header="보유 포지션 (Positions)" FontSize="13" FontWeight="SemiBold">
                            <DataGrid ItemsSource="{Binding Positions}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowBackground="#181A20"
                                      AlternatingRowBackground="#1E2329"
                                      Foreground="#EAECEF"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#2B313A"
                                      HeadersVisibility="Column"
                                      Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="심볼" Binding="{Binding Symbol}" Width="110"/>
                                    <DataGridTemplateColumn Header="방향/레버리지" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border CornerRadius="3" Padding="5,2" Margin="0,0,4,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#16382E"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLong}" Value="False">
                                                                        <Setter Property="Background" Value="#3B2228"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Side}" FontWeight="Bold" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#0ECB81"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLong}" Value="False">
                                                                            <Setter Property="Foreground" Value="#F6465D"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding Leverage, StringFormat='{}{0}x'}" Foreground="#F0B90B" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="수량" Binding="{Binding Size}" Width="80"/>
                                    <DataGridTextColumn Header="진입가격" Binding="{Binding EntryPrice, StringFormat='{}{0:N2}'}" Width="100"/>
                                    <DataGridTextColumn Header="시장가격" Binding="{Binding MarkPrice, StringFormat='{}{0:N2}'}" Width="100"/>
                                    <DataGridTextColumn Header="청산예정가" Binding="{Binding LiquidationPrice, StringFormat='{}{0:N2}'}" Width="100"/>
                                    <DataGridTemplateColumn Header="미실현 손익 (ROE%)" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FormattedPnL}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0ECB81"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProfit}" Value="False">
                                                                    <Setter Property="Foreground" Value="#F6465D"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관리" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="시장가 청산" 
                                                        FontSize="11" 
                                                        Height="24"
                                                        Padding="6,0"
                                                        Background="#2B313A"
                                                        Foreground="#EAECEF"
                                                        Command="{Binding DataContext.ClosePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- TAB 2: Open Orders -->
                        <TabItem Header="미체결 주문 (Open Orders)" FontSize="13" FontWeight="SemiBold">
                            <DataGrid ItemsSource="{Binding OpenOrders}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowBackground="#181A20"
                                      AlternatingRowBackground="#1E2329"
                                      Foreground="#EAECEF"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#2B313A"
                                      HeadersVisibility="Column"
                                      Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="주문번호" Binding="{Binding OrderId}" Width="100"/>
                                    <DataGridTextColumn Header="시간" Binding="{Binding FormattedTime}" Width="110"/>
                                    <DataGridTextColumn Header="종목" Binding="{Binding Symbol}" Width="90"/>
                                    <DataGridTemplateColumn Header="구분" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Side}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0ECB81"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBuy}" Value="False">
                                                                    <Setter Property="Foreground" Value="#F6465D"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="주문형태" Binding="{Binding OrderType}" Width="80"/>
                                    <DataGridTextColumn Header="주문가격" Binding="{Binding Price, StringFormat='{}{0:N2}'}" Width="100"/>
                                    <DataGridTextColumn Header="주문수량" Binding="{Binding Amount}" Width="80"/>
                                    <DataGridTemplateColumn Header="체결율" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Value="{Binding FilledPercent}" Maximum="100" Height="8" Background="#2B313A" Foreground="#0ECB81"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="취소" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="취소" 
                                                        FontSize="11" 
                                                        Height="24"
                                                        Padding="8,0"
                                                        Background="#3B2228"
                                                        Foreground="#F6465D"
                                                        BorderBrush="#F6465D"
                                                        Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- TAB 3: Active Trading Bots -->
                        <TabItem Header="실행 중인 자동 매매 봇 (Active Bots)" FontSize="13" FontWeight="SemiBold">
                            <DataGrid ItemsSource="{Binding ActiveBots}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowBackground="#181A20"
                                      AlternatingRowBackground="#1E2329"
                                      Foreground="#EAECEF"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#2B313A"
                                      HeadersVisibility="Column"
                                      Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="전략명" Binding="{Binding Name}" Width="160"/>
                                    <DataGridTextColumn Header="종목" Binding="{Binding Symbol}" Width="90"/>
                                    <DataGridTextColumn Header="유형" Binding="{Binding StrategyType}" Width="110"/>
                                    <DataGridTextColumn Header="투자금" Binding="{Binding AllocatedCapital, StringFormat='{}{0:N2} USDT'}" Width="110"/>
                                    <DataGridTemplateColumn Header="누적 손익 (수익률)" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FormattedProfit}" FontWeight="Bold" Foreground="#0ECB81"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="가동시간" Binding="{Binding RuntimeHours, StringFormat='{}{0} 시간'}" Width="80"/>
                                    <DataGridTextColumn Header="최근 시그널" Binding="{Binding LastSignal}" Width="*"/>
                                    <DataGridTemplateColumn Header="상태/제어" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton IsChecked="{Binding IsRunning}" 
                                                              Content="{Binding IsRunning, Converter={x:Null}}"
                                                              Height="24"
                                                              Width="70"
                                                              Command="{Binding DataContext.ToggleBotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Background" Value="#16382E"/>
                                                            <Setter Property="Foreground" Value="#0ECB81"/>
                                                            <Setter Property="Content" Value="가동중"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsChecked" Value="False">
                                                                    <Setter Property="Background" Value="#2B313A"/>
                                                                    <Setter Property="Foreground" Value="#848E9C"/>
                                                                    <Setter Property="Content" Value="정지됨"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- ================= RIGHT AREA: OrderBook & Manual Trading Panel ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- OrderBook & Recent Trades -->
                    <RowDefinition Height="1.2*"/>
                    <!-- Manual Order Form -->
                    <RowDefinition Height="1.5*"/>
                </Grid.RowDefinitions>

                <!-- OrderBook (호가창) -->
                <Border Grid.Row="0" Style="{StaticResource TradingCardStyle}" Margin="0,0,0,12" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="4,0,4,4">
                            <TextBlock Text="실시간 호가창 (OrderBook)" FontSize="12" FontWeight="SemiBold" Foreground="#848E9C"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="가격(USDT)" FontSize="11" Foreground="#848E9C" Margin="0,0,16,0"/>
                                <TextBlock Text="수량" FontSize="11" Foreground="#848E9C"/>
                            </StackPanel>
                        </Grid>

                        <!-- Asks (매도 호가) -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Asks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1" Height="20">
                                        <!-- Depth Bar Background (Red) -->
                                        <ProgressBar Value="{Binding DepthPercentage}" Maximum="100" 
                                                     HorizontalAlignment="Right" Width="180" Height="18"
                                                     Background="Transparent" Foreground="#3B2228" BorderThickness="0"
                                                     FlowDirection="RightToLeft"/>
                                        <Grid Margin="4,0">
                                            <TextBlock Text="{Binding FormattedPrice}" Foreground="#F6465D" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FormattedAmount}" Foreground="#EAECEF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Current Middle Price -->
                        <Border Grid.Row="2" Background="#1E2329" Padding="6,4" Margin="0,4" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SelectedMarket.FormattedPrice, FallbackValue='67,450.00'}" 
                                           FontSize="15" FontWeight="Bold" Foreground="#0ECB81" Margin="0,0,8,0"/>
                                <TextBlock Text="▲ 67,450.00 (Mark Price)" FontSize="11" Foreground="#848E9C" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Bids (매수 호가) -->
                        <ItemsControl Grid.Row="3" ItemsSource="{Binding Bids}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1" Height="20">
                                        <!-- Depth Bar Background (Green) -->
                                        <ProgressBar Value="{Binding DepthPercentage}" Maximum="100" 
                                                     HorizontalAlignment="Right" Width="180" Height="18"
                                                     Background="Transparent" Foreground="#16382E" BorderThickness="0"
                                                     FlowDirection="RightToLeft"/>
                                        <Grid Margin="4,0">
                                            <TextBlock Text="{Binding FormattedPrice}" Foreground="#0ECB81" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FormattedAmount}" Foreground="#EAECEF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Manual Order Form (수동 주문창) -->
                <Border Grid.Row="1" Style="{StaticResource TradingCardStyle}" Padding="14,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Buy / Sell Toggle Tabs -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Content="매수 (Long)" 
                                             IsChecked="{Binding OrderSide, Converter={x:Null}, FallbackValue=True}"
                                             Height="34" FontSize="13" FontWeight="Bold"
                                             Style="{DynamicResource ToggleButtonRadioGroupDefault}"
                                             Background="#16382E" Foreground="#0ECB81"
                                             BorderBrush="#0ECB81"/>
                                <RadioButton Grid.Column="1" Content="매도 (Short)" 
                                             Height="34" FontSize="13" FontWeight="Bold" Margin="4,0,0,0"
                                             Style="{DynamicResource ToggleButtonRadioGroupDefault}"
                                             Background="#3B2228" Foreground="#F6465D"
                                             BorderBrush="#F6465D"/>
                            </Grid>

                            <!-- Order Type & Leverage -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox SelectedValue="{Binding OrderType}" SelectedValuePath="Content" Height="30" FontSize="12">
                                    <ComboBoxItem Content="지정가 (Limit)" IsSelected="True"/>
                                    <ComboBoxItem Content="시장가 (Market)"/>
                                    <ComboBoxItem Content="스탑 지정가 (Stop-Limit)"/>
                                </ComboBox>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="레버리지:" Foreground="#848E9C" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Border Background="#2B313A" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding Leverage, StringFormat='{}{0}x'}" Foreground="#F0B90B" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Leverage Slider -->
                            <Slider Value="{Binding Leverage}" Minimum="1" Maximum="100" SmallChange="1" Margin="0,0,0,12" 
                                    TickFrequency="20" IsSnapToTickEnabled="False"/>

                            <!-- Price Input -->
                            <TextBlock Text="주문 가격 (USDT)" FontSize="11" Foreground="#848E9C" Margin="0,0,0,4"/>
                            <hc:NumericUpDown Value="{Binding OrderPrice}" Increment="5" DecimalPlaces="2" 
                                              Height="32" FontSize="13" Margin="0,0,0,10"
                                              Background="#1E2329" Foreground="#EAECEF" BorderBrush="#2B313A"/>

                            <!-- Amount Input -->
                            <TextBlock Text="주문 수량" FontSize="11" Foreground="#848E9C" Margin="0,0,0,4"/>
                            <hc:NumericUpDown Value="{Binding OrderAmount}" Increment="0.05" DecimalPlaces="4" 
                                              Height="32" FontSize="13" Margin="0,0,0,8"
                                              Background="#1E2329" Foreground="#EAECEF" BorderBrush="#2B313A"/>

                            <!-- Percentage Quick Buttons -->
                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                <Button Content="25%" Command="{Binding SetAmountPercentCommand}" CommandParameter="{x:Static vm:TradingViewModel.Create25}" 
                                        Height="26" Margin="1" FontSize="11" Background="#1E2329" Foreground="#848E9C"/>
                                <Button Content="50%" Command="{Binding SetAmountPercentCommand}" CommandParameter="{x:Static vm:TradingViewModel.Create50}" 
                                        Height="26" Margin="1" FontSize="11" Background="#1E2329" Foreground="#848E9C"/>
                                <Button Content="75%" Command="{Binding SetAmountPercentCommand}" CommandParameter="{x:Static vm:TradingViewModel.Create75}" 
                                        Height="26" Margin="1" FontSize="11" Background="#1E2329" Foreground="#848E9C"/>
                                <Button Content="100%" Command="{Binding SetAmountPercentCommand}" CommandParameter="{x:Static vm:TradingViewModel.Create100}" 
                                        Height="26" Margin="1" FontSize="11" Background="#1E2329" Foreground="#848E9C"/>
                            </UniformGrid>

                            <!-- Available Balance Info -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="주문 가능 잔고" FontSize="11" Foreground="#848E9C"/>
                                <TextBlock Text="{Binding AvailableBalance, StringFormat='{}{0:N2} USDT'}" 
                                           HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#EAECEF"/>
                            </Grid>

                            <!-- Order Execution Button -->
                            <Button Command="{Binding ExecuteOrderCommand}"
                                    Height="40" FontSize="14" FontWeight="Bold"
                                    BorderThickness="0"
                                    Background="#0ECB81" Foreground="#FFFFFF">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Flash24" FontSize="18" Margin="0,0,6,0"/>
                                    <TextBlock Text="즉시 주문 실행 (Place Order)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
