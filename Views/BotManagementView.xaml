<UserControl x:Class="CryptoTraderApp.Views.BotManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
             xmlns:vm="clr-namespace:CryptoTraderApp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:BotManagementViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#121418">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Stats Summary Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Bot Creation & Active Bots Grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Stats Summary Cards (Bound to Real ViewModel Properties) -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
            <!-- Card 1 -->
            <Border Style="{StaticResource TradingCardStyle}" Margin="0,0,12,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="가동 중인 봇" FontSize="12" Foreground="#848E9C"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding ActiveBotsCount}" FontSize="26" FontWeight="Bold" Foreground="#0ECB81"/>
                        <TextBlock Text="{Binding TotalBotsCount, StringFormat='{} / {0} 총 등록'}" FontSize="13" Foreground="#848E9C" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2 -->
            <Border Style="{StaticResource TradingCardStyle}" Margin="0,0,12,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="자동매매 누적 수익" FontSize="12" Foreground="#848E9C"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding TotalBotProfitKrw, StringFormat='{}{0:N0}'}" FontSize="26" FontWeight="Bold" Foreground="#0ECB81"/>
                        <TextBlock Text=" KRW" FontSize="13" Foreground="#0ECB81" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3 -->
            <Border Style="{StaticResource TradingCardStyle}" Margin="0,0,12,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="총 자동 체결 횟수" FontSize="12" Foreground="#848E9C"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding TotalTradesCount}" FontSize="26" FontWeight="Bold" Foreground="#EAECEF"/>
                        <TextBlock Text=" 회 완료" FontSize="13" Foreground="#848E9C" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 4 -->
            <Border Style="{StaticResource TradingCardStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="자동 봇 운용 자금" FontSize="12" Foreground="#848E9C"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding TotalBotCapitalKrw, StringFormat='{}{0:N0}'}" FontSize="26" FontWeight="Bold" Foreground="#F0B90B"/>
                        <TextBlock Text=" KRW" FontSize="13" Foreground="#848E9C" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 2. Main Content: Left (Create Bot) + Right (Active Bots List) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Bot Strategy Deployment Panel -->
            <Border Grid.Column="0" Style="{StaticResource TradingCardStyle}" Margin="0,0,16,0" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Bot24" FontSize="20" Foreground="#0ECB81" Margin="0,0,8,0"/>
                            <TextBlock Text="새 빗썸 자동 매매 봇 배포" FontSize="16" FontWeight="Bold" Foreground="#EAECEF"/>
                        </StackPanel>

                        <!-- Bot Name -->
                        <TextBlock Text="봇 식별 이름" FontSize="12" Foreground="#848E9C" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewBotName}" Height="34" FontSize="13" Margin="0,0,0,12" Background="#1E2329" Foreground="#EAECEF" BorderBrush="#2B313A"/>

                        <!-- Target Symbol -->
                        <TextBlock Text="대상 코인 (빗썸 KRW 마켓)" FontSize="12" Foreground="#848E9C" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding NewBotSymbol}" SelectedValuePath="Content" Height="34" FontSize="13" Margin="0,0,0,12">
                            <ComboBoxItem Content="BTC/KRW" IsSelected="True"/>
                            <ComboBoxItem Content="ETH/KRW"/>
                            <ComboBoxItem Content="SOL/KRW"/>
                            <ComboBoxItem Content="XRP/KRW"/>
                            <ComboBoxItem Content="DOGE/KRW"/>
                        </ComboBox>

                        <!-- Strategy Type -->
                        <TextBlock Text="알고리즘 전략 유형" FontSize="12" Foreground="#848E9C" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding NewStrategyType}" SelectedValuePath="Content" Height="34" FontSize="13" Margin="0,0,0,16">
                            <ComboBoxItem Content="Grid Trading (격자 무한 매매)" IsSelected="True"/>
                            <ComboBoxItem Content="DCA Bot (분할 매수 마틴게일)"/>
                            <ComboBoxItem Content="Bollinger Band (변동성 밴드 역추세)"/>
                            <ComboBoxItem Content="RSI Momentum (과매도 돌파 매수)"/>
                        </ComboBox>

                        <!-- Strategy Parameters -->
                        <Border Background="#1E2329" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="그리드 상세 파라미터 (KRW)" FontSize="12" FontWeight="SemiBold" Foreground="#F0B90B" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="격자 하한가 (KRW)" FontSize="11" Foreground="#848E9C"/>
                                        <hc:NumericUpDown Value="{Binding LowerPrice}" DecimalPlaces="0" Increment="500000" Height="30" FontSize="12" Background="#121418" Foreground="#EAECEF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="격자 상한가 (KRW)" FontSize="11" Foreground="#848E9C"/>
                                        <hc:NumericUpDown Value="{Binding UpperPrice}" DecimalPlaces="0" Increment="500000" Height="30" FontSize="12" Background="#121418" Foreground="#EAECEF"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="격자 분할 개수" FontSize="11" Foreground="#848E9C"/>
                                        <hc:NumericUpDown Value="{Binding GridCount}" Minimum="2" Maximum="150" Height="30" FontSize="12" Background="#121418" Foreground="#EAECEF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="투자 배분금 (KRW)" FontSize="11" Foreground="#848E9C"/>
                                        <hc:NumericUpDown Value="{Binding InvestAmount}" DecimalPlaces="0" Increment="100000" Height="30" FontSize="12" Background="#121418" Foreground="#EAECEF"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Deploy Button -->
                        <Button Command="{Binding CreateNewBotCommand}"
                                Height="40" FontSize="14" FontWeight="Bold"
                                Background="#0ECB81" Foreground="#FFFFFF" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="18" Margin="0,0,6,0"/>
                                <TextBlock Text="전략 가동 및 즉시 배포" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Active Bots List -->
            <Border Grid.Column="1" Style="{StaticResource TradingCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="등록된 자동 매매 봇 목록" FontSize="16" FontWeight="Bold" Foreground="#EAECEF"/>
                        <TextBlock Text="실시간 빗썸 호가 연동 및 자동 주문 실행" FontSize="12" Foreground="#848E9C" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Empty Placeholder when no bots -->
                    <Border Grid.Row="1" Background="#1E2329" CornerRadius="8" Padding="24"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BotList.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Bot24" FontSize="36" Foreground="#848E9C" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="현재 가동 중인 자동 매매 봇이 없습니다." FontWeight="Bold" FontSize="15" Foreground="#EAECEF" HorizontalAlignment="Center"/>
                            <TextBlock Text="왼쪽 패널에서 원하는 코인과 그리드/지표 전략 파라미터를 설정한 후 [전략 가동 및 즉시 배포]를 눌러 봇을 등록하세요." 
                                       FontSize="12" Foreground="#848E9C" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Bot Cards / Grid -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding BotList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E2329" BorderBrush="#2B313A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Bot Icon & State Indicator -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#121418" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <ui:SymbolIcon Symbol="Bot24" FontSize="22" Foreground="#0ECB81" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Bot Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#EAECEF" Margin="0,0,8,0"/>
                                                <Border Background="#2B313A" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Symbol}" Foreground="#F0B90B" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="#2B313A" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding StrategyType}" Foreground="#848E9C" FontSize="11"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="최근 시그널: " FontSize="12" Foreground="#848E9C"/>
                                                <TextBlock Text="{Binding LastSignal}" FontSize="12" Foreground="#0ECB81" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ExecutedTrades, StringFormat='{} (체결 {0}건)'}" FontSize="11" Foreground="#848E9C" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Profit & Runtime -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,24,0">
                                            <TextBlock Text="{Binding FormattedProfit}" FontSize="14" FontWeight="Bold" Foreground="#0ECB81" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding RuntimeHours, StringFormat='{}가동: {0}시간 / 투자금: {1:N0} KRW'}" FontSize="11" Foreground="#848E9C" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- Control Toggle & Delete -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton IsChecked="{Binding IsRunning}" 
                                                          Width="76" Height="30" Margin="0,0,8,0"
                                                          Command="{Binding DataContext.ToggleBotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Background" Value="#16382E"/>
                                                        <Setter Property="Foreground" Value="#0ECB81"/>
                                                        <Setter Property="Content" Value="가동중"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter Property="Background" Value="#2B313A"/>
                                                                <Setter Property="Foreground" Value="#848E9C"/>
                                                                <Setter Property="Content" Value="정지"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>

                                            <Button Content="삭제" Height="30" Width="50" FontSize="11"
                                                    Background="#3B2228" Foreground="#F6465D" BorderBrush="#F6465D"
                                                    Command="{Binding DataContext.DeleteBotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
