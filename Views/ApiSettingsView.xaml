<UserControl x:Class="CryptoTraderApp.Views.ApiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:hc="https://handyorg.github.io/langs/wpf"
             xmlns:vm="clr-namespace:CryptoTraderApp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ApiSettingsViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#121418">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Settings Form & Registered APIs -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource TradingCardStyle}" Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Key24" FontSize="22" Foreground="#F0B90B" Margin="0,0,10,0"/>
                    <TextBlock Text="거래소 API 연동 및 지원 현황 (Exchange API Status)" FontSize="18" FontWeight="Bold" Foreground="#EAECEF"/>
                </StackPanel>
                <TextBlock Text="※ 현재 빗썸(Bithumb) Developer Open API를 통해 실시간 시세, 호가, 캔들스틱 및 보조지표 백데이터가 연동되어 있습니다. 타 거래소는 지원 준비 중입니다." 
                           FontSize="12" Foreground="#F0B90B" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Form & List -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Add API Key Form -->
            <Border Grid.Column="0" Style="{StaticResource TradingCardStyle}" Margin="0,0,16,0" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="거래소 API 설정 및 점검" FontSize="15" FontWeight="Bold" Foreground="#EAECEF" Margin="0,0,0,14"/>

                        <!-- Exchange Selection -->
                        <TextBlock Text="거래소 선택" FontSize="12" Foreground="#848E9C" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding SelectedExchange}" SelectedValuePath="Content" Height="34" FontSize="13" Margin="0,0,0,12">
                            <ComboBoxItem Content="Bithumb (빗썸)" IsSelected="True"/>
                            <ComboBoxItem Content="Binance (선물/현물) [준비 중]"/>
                            <ComboBoxItem Content="Upbit (업비트) [준비 중]"/>
                            <ComboBoxItem Content="Bybit (바이비트) [준비 중]"/>
                            <ComboBoxItem Content="OKX [준비 중]"/>
                        </ComboBox>

                        <!-- API Key -->
                        <TextBlock Text="Connect Key / API Key" FontSize="12" Foreground="#848E9C" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding InputApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="34" FontSize="12" Margin="0,0,0,12" 
                                 Background="#1E2329" Foreground="#EAECEF" BorderBrush="#2B313A"/>

                        <!-- Secret Key -->
                        <TextBlock Text="Secret Key" FontSize="12" Foreground="#848E9C" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding InputSecretKey, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="34" FontSize="12" Margin="0,0,0,12" 
                                 Background="#1E2329" Foreground="#EAECEF" BorderBrush="#2B313A"/>

                        <!-- Testnet Toggle -->
                        <CheckBox Content="테스트넷(Testnet / 모의투자) 환경 사용" IsChecked="{Binding IsTestnet}" 
                                  FontSize="12" Foreground="#848E9C" Margin="0,0,0,18"/>

                        <!-- Save & Test Button -->
                        <Button Command="{Binding SaveAndTestConnectionCommand}"
                                Height="40" FontSize="14" FontWeight="Bold"
                                Background="#0ECB81" Foreground="#FFFFFF" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Margin="0,0,6,0"/>
                                <TextBlock Text="빗썸 API 상태 확인 및 적용" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Status Message -->
                        <Border Background="#1E2329" CornerRadius="6" Padding="10" Margin="0,16,0,0">
                            <TextBlock Text="{Binding ConnectionStatusMessage}" TextWrapping="Wrap" FontSize="12" Foreground="#848E9C"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Registered Exchanges List -->
            <Border Grid.Column="1" Style="{StaticResource TradingCardStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="거래소별 연동 및 지원 현황" FontSize="15" FontWeight="Bold" Foreground="#EAECEF" Margin="0,0,0,14"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ApiConfigs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E2329" BorderBrush="#2B313A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon -->
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" Background="#121418" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <ui:SymbolIcon FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Clock24"/>
                                                        <Setter Property="Foreground" Value="#848E9C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Symbol" Value="Checkmark24"/>
                                                                <Setter Property="Foreground" Value="#0ECB81"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ExchangeName}" FontWeight="Bold" FontSize="14" Foreground="#EAECEF" Margin="0,0,10,0"/>
                                                <Border CornerRadius="4" Padding="6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#2B313A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                    <Setter Property="Background" Value="#16382E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#848E9C"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                        <Setter Property="Foreground" Value="#0ECB81"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ApiKey, StringFormat='{}상태/키: {0}'}" FontSize="12" Foreground="#848E9C" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Ping & Time -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="서비스 준비 중"/>
                                                        <Setter Property="Foreground" Value="#848E9C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Text" Value="빗썸 Open API 활성"/>
                                                                <Setter Property="Foreground" Value="#0ECB81"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="공개 시세/차트/오더북" FontSize="11" Foreground="#848E9C" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Action Button -->
                                        <Button Grid.Column="3" Height="30" FontSize="11" Padding="10,0"
                                                Command="{Binding DataContext.DeleteConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="대기"/>
                                                    <Setter Property="Background" Value="#1E2329"/>
                                                    <Setter Property="Foreground" Value="#848E9C"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                            <Setter Property="Content" Value="활성 상태"/>
                                                            <Setter Property="Background" Value="#16382E"/>
                                                            <Setter Property="Foreground" Value="#0ECB81"/>
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
