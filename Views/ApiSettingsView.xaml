<UserControl x:Class="CryptoTraderApp.Views.ApiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:hc="https://handyorg.github.io/langs/wpf"
             xmlns:vm="clr-namespace:CryptoTraderApp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ApiSettingsViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#121418">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Settings Form & Registered APIs -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource TradingCardStyle}" Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Key24" FontSize="22" Foreground="#F0B90B" Margin="0,0,10,0"/>
                    <TextBlock Text="거래소 API 키 보안 관리 (Exchange API Settings)" FontSize="18" FontWeight="Bold" Foreground="#EAECEF"/>
                </StackPanel>
                <TextBlock Text="※ API Key는 오직 로컬 환경에 DPAPI(Data Protection API)로 암호화되어 보관되며, 출금 권한은 반드시 해제된 API Key만을 등록하세요." 
                           FontSize="12" Foreground="#F0B90B" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Form & List -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Add API Key Form -->
            <Border Grid.Column="0" Style="{StaticResource TradingCardStyle}" Margin="0,0,16,0" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="새 거래소 API 연동 등록" FontSize="15" FontWeight="Bold" Foreground="#EAECEF" Margin="0,0,0,14"/>

                        <!-- Exchange Selection -->
                        <TextBlock Text="거래소 선택" FontSize="12" Foreground="#848E9C" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding SelectedExchange}" SelectedValuePath="Content" Height="34" FontSize="13" Margin="0,0,0,12">
                            <ComboBoxItem Content="Binance (선물/현물)" IsSelected="True"/>
                            <ComboBoxItem Content="Upbit (업비트)"/>
                            <ComboBoxItem Content="Bithumb (빗썸)"/>
                            <ComboBoxItem Content="Bybit (바이비트)"/>
                            <ComboBoxItem Content="OKX"/>
                        </ComboBox>

                        <!-- API Key -->
                        <TextBlock Text="Access / API Key" FontSize="12" Foreground="#848E9C" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding InputApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="34" FontSize="12" Margin="0,0,0,12" 
                                 Background="#1E2329" Foreground="#EAECEF" BorderBrush="#2B313A"/>

                        <!-- Secret Key -->
                        <TextBlock Text="Secret Key" FontSize="12" Foreground="#848E9C" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding InputSecretKey, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="34" FontSize="12" Margin="0,0,0,12" 
                                 Background="#1E2329" Foreground="#EAECEF" BorderBrush="#2B313A"/>

                        <!-- Testnet Toggle -->
                        <CheckBox Content="테스트넷(Testnet / 모의투자) 환경 사용" IsChecked="{Binding IsTestnet}" 
                                  FontSize="12" Foreground="#848E9C" Margin="0,0,0,18"/>

                        <!-- Save & Test Button -->
                        <Button Command="{Binding SaveAndTestConnectionCommand}"
                                Height="40" FontSize="14" FontWeight="Bold"
                                Background="#0ECB81" Foreground="#FFFFFF" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Margin="0,0,6,0"/>
                                <TextBlock Text="연결 테스트 및 안전 저장" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Status Message -->
                        <Border Background="#1E2329" CornerRadius="6" Padding="10" Margin="0,16,0,0">
                            <TextBlock Text="{Binding ConnectionStatusMessage}" TextWrapping="Wrap" FontSize="12" Foreground="#848E9C"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Registered Exchanges List -->
            <Border Grid.Column="1" Style="{StaticResource TradingCardStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="연동 완료된 거래소 계정 목록" FontSize="15" FontWeight="Bold" Foreground="#EAECEF" Margin="0,0,0,14"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ApiConfigs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E2329" BorderBrush="#2B313A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon -->
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" Background="#121418" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="20" Foreground="#0ECB81" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ExchangeName}" FontWeight="Bold" FontSize="14" Foreground="#EAECEF" Margin="0,0,10,0"/>
                                                <Border Background="#16382E" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="정상 연결됨 (Connected)" Foreground="#0ECB81" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ApiKey, StringFormat='{}API Key: {0}'}" FontSize="12" Foreground="#848E9C" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Ping & Time -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                            <TextBlock Text="Ping: 22ms" FontSize="12" FontWeight="SemiBold" Foreground="#0ECB81" HorizontalAlignment="Right"/>
                                            <TextBlock Text="권한: 읽기/매매 (출금제한됨)" FontSize="11" Foreground="#848E9C" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Delete Button -->
                                        <Button Grid.Column="3" Content="연동 해제" Height="30" FontSize="11" Padding="10,0"
                                                Background="#3B2228" Foreground="#F6465D" BorderBrush="#F6465D"
                                                Command="{Binding DataContext.DeleteConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
